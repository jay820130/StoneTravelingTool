# Copy to .env.local; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: local administration and background parser, never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Gemini via the OpenAI-compatible endpoint. Model must be explicitly configured.
# No external AI request without this key; do not add a NEXT_PUBLIC_ prefix.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
# Used by scheduled GET /api/worker. Use a strong random value in deployment settings.
CRON_SECRET=
# Optional HTTPS tile provider. Review attribution/terms before production use.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Optional manual geocoding. Disabled until a provider is deliberately selected.
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=
# Read https://operations.osmfoundation.org/policies/nominatim/ before opting in.
NOMINATIM_POLICY_ACCEPTED=false
